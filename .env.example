# =============================================================================
# ServiceAgent AI — variables de entorno (PLANTILLA, sin valores reales)
# =============================================================================
# NUNCA subas valores reales al repo. Copia este archivo y llénalo en local:
#
#   API (Worker):   cp .env.example apps/api/.dev.vars    (solo la sección API)
#   Web:            cp .env.example apps/web/.env.local   (solo variables VITE_*)
#   Simuladores:    cp .env.example apps/simuladores/.env.local
#
# En producción los secretos del Worker se cargan con `wrangler secret put <NOMBRE>`
# y los de GitHub Actions en Settings → Secrets and variables → Actions.
# Ver README.md → "Variables de entorno y secretos".
# =============================================================================

# -----------------------------------------------------------------------------
# API (apps/api) — se leen desde apps/api/.dev.vars en local
# -----------------------------------------------------------------------------

# Supabase (Project Settings → API)
SUPABASE_URL=https://<tu-proyecto>.supabase.co
SUPABASE_ANON_KEY=
# Llave de servicio: SOLO en la API. Jamás en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Auth por PIN (US-04): secreto para firmar los JWT propios (mínimo 32 caracteres).
# Genéralo con:  openssl rand -base64 32
# Local: en apps/api/.dev.vars · Producción: cd apps/api && pnpm exec wrangler secret put JWT_SECRET
JWT_SECRET=
# Duración del token: 8h, 30m, 900s…
JWT_EXPIRES_IN=8h

# Pepper de los PIN (D13): se mezcla con cada PIN antes del hash. Mínimo 32 caracteres.
# Genéralo con:  openssl rand -base64 32 · Cambiarlo invalida TODOS los PIN guardados.
# Desarrollo: el mismo para todo el equipo (compartido por canal privado, nunca en el repo),
# porque el seed de supabase/seed/ se genera con él. Producción: uno distinto con wrangler secret put.
PIN_PEPPER=

# Retell AI (dashboard de Retell → API Keys). Se usa para verificar X-Retell-Signature.
RETELL_API_KEY=
RETELL_AGENT_ID=

# Banco simulado: secreto compartido para la firma HMAC de POST /webhooks/banco
BANCO_WEBHOOK_SECRET=

# Cloudflare Turnstile (anti-abuso del chat): llave secreta, solo backend
TURNSTILE_SECRET_KEY=

# Orígenes permitidos para CORS (separados por coma)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# -----------------------------------------------------------------------------
# Frontends (apps/web y apps/simuladores) — Vite solo expone variables VITE_*
# Todo lo VITE_* termina en el navegador: nunca pongas secretos aquí.
# -----------------------------------------------------------------------------
VITE_API_URL=http://localhost:8787
VITE_SUPABASE_URL=https://<tu-proyecto>.supabase.co
VITE_SUPABASE_ANON_KEY=
VITE_TURNSTILE_SITE_KEY=
VITE_RETELL_AGENT_ID=

# -----------------------------------------------------------------------------
# Cloudflare (solo para desplegar desde tu máquina; en CI son secretos de GitHub)
# -----------------------------------------------------------------------------
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
