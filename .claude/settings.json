{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(.env)",
      "Read(.env.*)",
      "Read(!.env.example)",
      "Read(.dev.vars)",
      "Read(.dev.vars.*)",
      "Read(*.pem)",
      "Read(*.key)",
      "Read(secrets/**)"
    ]
  }
}
