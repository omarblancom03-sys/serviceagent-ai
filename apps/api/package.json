{
  "name": "@serviceagent/api",
  "version": "0.1.0",
  "private": true,
  "description": "API de ServiceAgent AI (Hono sobre Cloudflare Workers)",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "hash-pin": "node --env-file-if-exists=.dev.vars --experimental-strip-types --no-warnings scripts/hashPin.ts"
  },
  "dependencies": {
    "@hono/swagger-ui": "^0.6.1",
    "@hono/zod-openapi": "^1.6.3",
    "@serviceagent/shared": "workspace:*",
    "@supabase/supabase-js": "^2.117.1",
    "hono": "^4.13.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260920.1",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.130.0"
  }
}
