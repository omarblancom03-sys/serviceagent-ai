{
  "chat_agent": {
    "agent_name": "El Granero - chat",
    "language": "es-419",
    "timezone": null,
    "end_chat_after_silence_ms": 360000,
    "auto_close_message": null,
    "webhook_url": null,
    "handbook_config": {
      "default_personality": false,
      "ai_disclosure": false
    },
    "post_chat_analysis_model": "gpt-5-nano",
    "data_storage_setting": "everything",
    "data_storage_retention_days": 30,
    "contact_memory_config": {
      "enable_read": true,
      "enable_update": false
    }
  },
  "retell_llm": {
    "model": "gpt-6-luna",
    "model_temperature": null,
    "start_speaker": "agent",
    "begin_message": null,
    "general_prompt": "agent/prompt.md",
    "general_tools": [
      {
        "type": "custom",
        "name": "cotizar_pedido",
        "description": "Revisa contra el menú lo que pide el cliente y devuelve los nombres oficiales y los precios, o las aclaraciones que hay que preguntarle. No registra ningún pedido. Úsala cada vez que el cliente pida platillos, bebidas o extras, cambie su pedido o pregunte el precio de un platillo concreto. Manda siempre el pedido completo.",
        "url": "/pedidos/cotizar",
        "method": "POST",
        "parameters": "agent/functions/cotizar_pedido.json",
        "args_at_root": false,
        "timeout_ms": 10000,
        "max_retry": 0,
        "speak_during_execution": false,
        "speak_after_execution": true
      }
    ],
    "knowledge_base_ids": []
  }
}
